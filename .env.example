# Sample environment for Pulse MCP. Copy to `.env` and fill in as needed.
# All vars are optional; defaults are baked in for the common case.

# Pulse API host. Override only if pointing at a non-prod environment.
PULSE_API_BASE_URL=https://prod.apis.pulse.studiographene.com

# Path to the user's Pulse access token file. Defaults to ~/.pulse-mcp/token.json.
PULSE_MCP_TOKEN_PATH=

# Per-request HTTP timeout in milliseconds. Default 60000 (60 s); some metric
# endpoints take 3-30 s, so values below ~10000 are not recommended.
PULSE_API_TIMEOUT_MS=

# Set to "false" to disable anonymous tool-usage telemetry (Amplitude). Defaults
# to enabled. See README.md > Telemetry for the full property allowlist.
PULSE_MCP_TELEMETRY=

# Override the built-in Amplitude write key. Useful only for forks pointing at
# their own Amplitude project; the built-in key targets the Studio Graphene
# Pulse project and is otherwise the right value.
PULSE_MCP_AMPLITUDE_KEY=
